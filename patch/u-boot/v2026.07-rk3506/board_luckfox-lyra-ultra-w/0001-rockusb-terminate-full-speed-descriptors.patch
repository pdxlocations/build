usb: gadget: rockusb: terminate the full-speed descriptor list

usb_descriptor_fillbuf walks until NULL. The full-speed list is also
used for other-speed configuration requests on a high-speed connection.
Without a terminator, descriptor serialization reads beyond the array.

diff --git a/drivers/usb/gadget/f_rockusb.c b/drivers/usb/gadget/f_rockusb.c
--- a/drivers/usb/gadget/f_rockusb.c
+++ b/drivers/usb/gadget/f_rockusb.c
@@ -71,6 +71,7 @@
 	(struct usb_descriptor_header *)&interface_desc,
 	(struct usb_descriptor_header *)&fs_ep_in,
 	(struct usb_descriptor_header *)&fs_ep_out,
+	NULL,
 };
 
 static struct usb_descriptor_header *rkusb_hs_function[] = {
